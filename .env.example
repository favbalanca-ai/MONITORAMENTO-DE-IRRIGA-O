# Copie para .env (que fica fora do git) e preencha.

# --- Estação Ecowitt (gere chaves NOVAS: as antigas circularam na planilha) ---
ECOWITT_APPLICATION_KEY=
ECOWITT_API_KEY=
ECOWITT_MAC=
# Fuso da estação (IANA). Goiás/DF/Bahia/Minas: America/Sao_Paulo · Mato Grosso: America/Cuiaba.
ESTACAO_FUSO=America/Sao_Paulo
# "rainfall" (pluviômetro de báscula) ou "rainfall_piezo" (WS90/piezo).
ECOWITT_GRUPO_CHUVA=rainfall

# --- Banco e relatório ---
BANCO=dados/manejo.db
# Depois das 18:00 (a janela do dia fecha às 18h).
HORA_RELATORIO=18:10
# Canais separados por vírgula: console, arquivo, email
NOTIFICAR=console,arquivo
PASTA_RELATORIOS=dados/relatorios

# --- E-mail (SMTP). Gmail: smtp.gmail.com, porta 465, senha de app em myaccount.google.com/apppasswords ---
SMTP_HOST=
SMTP_PORTA=465
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_DE=
# Quem recebe (separe por vírgula). Confirmar quem deve receber os avisos.
EMAIL_PARA=
