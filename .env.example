# Copie para .env (que fica fora do git) e preencha com chaves NOVAS geradas na Ecowitt.
ECOWITT_APPLICATION_KEY=
ECOWITT_API_KEY=
ECOWITT_MAC=

# Fuso da estação (IANA). Goiás/DF/Bahia/Minas: America/Sao_Paulo · Mato Grosso: America/Cuiaba.
ESTACAO_FUSO=America/Sao_Paulo
# "rainfall" (pluviômetro de báscula) ou "rainfall_piezo" (WS90/piezo).
ECOWITT_GRUPO_CHUVA=rainfall
PASTA_LEITURAS=dados/leituras
